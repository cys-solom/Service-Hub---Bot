# ===========================================
# Diaa Store Platform — Environment Variables
# ===========================================

# --- App ---
APP_NAME=Diaa Store
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-string
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/diaastore
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diaastore

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Bot ---
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789,987654321
STORE_NAME=Diaa Store
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
SUPPORT_USERNAME=diaa_support
CHANNEL_URL=https://t.me/diaastore_channel

# --- Payment ---
PAYMENT_TIMEOUT_MINUTES=30
AUTO_DELIVERY=true

# --- Reseller API (VEX) ---
RESELLER_API_BASE_URL=https://lshnsppqjcznfmdqwgfc.supabase.co/functions/v1/reseller-api
RESELLER_API_KEY=your_key_here

# --- Crypto Wallets ---
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
BTC_ADDRESS=

# --- External API Keys ---
TRONGRID_API_KEY=
BSCSCAN_API_KEY=
BLOCKCHAIN_INFO_API_KEY=

# --- JWT ---
JWT_SECRET_KEY=change-this-to-random-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Admin Panel ---
VITE_API_URL=http://localhost:8000/api/v1
