# =================================══════════════════
# Service Hub — Vercel Environment Variables Template
# =================================══════════════════

# ───────────────────────────────────────────────────
# OPTION 1: If you are deploying the Admin Panel (Vite/React)
# ───────────────────────────────────────────────────
# You only need this single variable in Vercel:

VITE_API_URL="https://your-backend-vps-ip-or-domain.com/api/v1"


# ───────────────────────────────────────────────────
# OPTION 2: If you are deploying the Next.js App (New Bot folder)
# ───────────────────────────────────────────────────
# Add these variables to your Vercel Project Settings:

DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_SECRET="random_secure_32_character_string"

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_password"

SESSION_SECRET="random_secure_32_character_string_for_cookie"

NEXT_PUBLIC_APP_URL="https://your-project-name.vercel.app"
